# ============================================================================
#  Patientenaufruf - Umgebungsvariablen
#  Diese Datei nach ".env" kopieren und ausfuellen. .env gehoert NICHT ins Git.
# ============================================================================

# --- Datenbank -------------------------------------------------------------
# SQLite-Datei (wird beim ersten Start angelegt). Standard: data/patientenaufruf.db
#DB_PATH=./data/patientenaufruf.db

# Zum Testen auf "true" setzen: Datenbank nur im Arbeitsspeicher, Daten sind
# nach dem Beenden weg.
USE_MEMORY_DB=false

# --- Server ----------------------------------------------------------------
PORT=3300
NODE_ENV=production
TZ=Europe/Berlin

# Oeffentlich erreichbare Basis-URL dieses Servers.
# WICHTIG: Mopidy und der Wartezimmer-TV laden ihre Daten ueber diese URL,
# "localhost" funktioniert deshalb NICHT.
APP_PUBLIC_URL=http://192.168.130.196:3300

# --- Sicherheit ------------------------------------------------------------
# Zufaelliger Schluessel zum Signieren der Login-Sitzung.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Zugangs-PIN/Passwort fuer die Bedienoberflaeche (Praxispersonal).
# Leer lassen + SECURITY_AUTH_ENABLED=false NUR in einem abgeschotteten Netz.
APP_PIN=

# Token fuer Anzeige-Geraete (Wartezimmer-TV, Monitor-Browser, RSS-Feed).
# Die Anzeigeseiten werden damit aufgerufen: /tv?token=...
DISPLAY_TOKEN=

SECURITY_AUTH_ENABLED=true

# --- Mopidy / Snapcast -----------------------------------------------------
MOPIDY_ENABLED=true
MOPIDY_RPC_URL=http://192.168.130.196:6680/mopidy/rpc

# --- piSignage -------------------------------------------------------------
SIGNAGE_ENABLED=true
SIGNAGE_HOST=192.168.130.204
SIGNAGE_PORT=8000
SIGNAGE_USER=pi
SIGNAGE_PASSWORD=

# --- Text-to-Speech (Piper) ------------------------------------------------
TTS_ENABLED=true
# Pfad zur Piper-Binary (im Docker-Image bereits im PATH).
PIPER_BIN=piper
# Verzeichnis mit den .onnx-Stimmmodellen.
PIPER_VOICES_DIR=./voices
# Aktive Stimme (Dateiname ohne .onnx). Nach dem Training: "de_DE-praxis-medium".
PIPER_VOICE=de_DE-thorsten-medium

# --- Wetter-Seite (/wetter) ------------------------------------------------
# API-Schluessel von openweathermap.org. Bleibt auf dem Server, der Browser
# des Fernsehers bekommt ihn nie zu sehen.
OPENWEATHER_API_KEY=
# Postleitzahl fuer die Vorhersage (Standard aus config/default.json: 55490)
#WEATHER_ZIP=55490

# --- Docker ----------------------------------------------------------------
# Port, unter dem der Container auf dem Server erreichbar ist.
HOST_PORT=3300
# Ordner auf dem Server mit den Piper-Stimmen (*.onnx + *.onnx.json).
PIPER_VOICES_HOST_DIR=../voices
